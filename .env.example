# Copy this file to .env and fill in the values (see docs/SETUP.md).
# .env is git-ignored — never commit real keys.

# Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# openrouteservice.org → Dashboard → token
EXPO_PUBLIC_ORS_KEY=

# Google Cloud → Maps SDK for Android key (used at build time in app.config)
GOOGLE_MAPS_ANDROID_KEY=
